{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/download/(.*)",
      "destination": "https://family-tracker-fidw.onrender.com/download/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://family-tracker-fidw.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

