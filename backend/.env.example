# FamilyTracker Backend Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_change_me
DB_PATH=./data/familytracker.db
CORS_ORIGIN=http://localhost:5173
