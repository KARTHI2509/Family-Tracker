{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/FamilyTracker.apk",
      "destination": "https://family-tracker-fidw.onrender.com/FamilyTracker.apk"
    },
    {
      "source": "/download/(.*)",
      "destination": "https://family-tracker-fidw.onrender.com/download/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://family-tracker-fidw.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

